node_modules/
.next/
out/
dist/
__pycache__/
*.pyc
.venv/
venv/

# Claude Code lokal
.claude/settings.local.json
backup/

# OS
.DS_Store
Thumbs.db

# TypeScript: inkrementelle Build-Info nie mitliefern.
# Nixpacks haengt sonst einen Cache-Ordner auf diese Datei, der Build bricht ab.
*.tsbuildinfo
