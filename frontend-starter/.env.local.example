# Env-Variablen des Frontend-Starters (nur Platzhalter, keine echten Werte committen).
# Lokal: nach .env.local kopieren und ausfüllen. Beim Veröffentlichen über buildbar
# gibt Claude die Werte beim Deploy-Aufruf mit (je Zeile KEY=VALUE).
# Zugangsdaten stehen im Bootcamp-Zugangsbereich: https://buildbar.at/oew#zugang

# n8n-Basis-URL (Muster A: Webhook-Aufruf aus dem Frontend)
# Adresse deiner n8n: zentrale Bootcamp-n8n oder deine eigene, z. B. https://DEINE-N8N-ADRESSE
NEXT_PUBLIC_N8N_BASE=

# Pfad des Beispiel-Webhooks (ohne /webhook/). Leer = "hello".
# Auf der zentralen Bootcamp-n8n mit eigenem Kürzel, z. B. mk-hello (Pfade gelten für die ganze n8n).
NEXT_PUBLIC_HELLO_PATH=

# KI-Chat (Muster C, optional). ACHTUNG: /api/chat hat KEINEN Login (offener KI-Proxy).
# Nur mit Schutz (Login, Zugangscode) öffentlich einschalten, nie den gemeinsamen
# Bootcamp-Key ungeschützt veröffentlichen. Key nur serverseitig, nie als NEXT_PUBLIC_*.
CHAT_ENABLED=false
ANTHROPIC_API_KEY=

# ÖW-Supabase (nur falls die App Datenbank, Login oder Dateien braucht):
# Project-URL und anon-Key aus dem Zugangsbereich. Den service_role-Key NIE hier
# eintragen, er gehört nur serverseitig in n8n.
# Aus dem Frontend nur Tabellen mit aktivierter Row Level Security (RLS) und passenden
# Policies ansprechen. Ohne RLS die Daten nur über n8n lesen und schreiben.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NocoDB (https://nocodb.buildbar.at): meist einfacher über n8n statt direkt aus dem Frontend.
# Einen NocoDB-API-Token nie als NEXT_PUBLIC_* ins Frontend geben.
NEXT_PUBLIC_NOCODB_URL=
